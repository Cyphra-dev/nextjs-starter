{
  "name": "cyphra-nextjs-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cyphra migrate deploy && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "cyphra generate",
    "db:dev": "cyphra dev",
    "db:migrate": "cyphra migrate dev",
    "db:generate": "cyphra generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cyphra": "^0.2.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cyphra/cli": "^0.2.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.11.2"
}
